# Copy these into your host's environment variables (or a .env your host loads).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=www.yourdomain.com,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# Business details shown on the site
SITE_DOMAIN=https://www.yourdomain.com
SITE_EMAIL=you@yourdomain.com
SITE_PHONE=(555) 010-0199
SITE_PHONE_LINK=+15550100199
SITE_AREA=Central Texas (fictional demo)

# Email new contact messages to you (optional)
CONTACT_NOTIFY_EMAIL=you@yourdomain.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=website@yourdomain.com

# Trustpilot (optional). Leave empty to show the footer placeholder.
TRUSTPILOT_BUSINESS_UNIT_ID=
TRUSTPILOT_REVIEW_URL=

# Live chat via Tawk.to (optional). Leave empty to use the built-in message bubble.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=default

# Map styles for /map/ (optional). Defaults to OpenFreeMap Positron (light) and Dark.
MAP_STYLE_LIGHT=
MAP_STYLE_DARK=

# Google sign-in for /admin/ (optional). In Google Cloud Console > APIs & Services > Credentials,
# create an OAuth client (Web application) with this authorized redirect URI:
#   https://www.yourdomain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
